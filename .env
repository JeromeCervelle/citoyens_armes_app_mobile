API_URL=http://10.0.2.2:9090/api

# === Gestion des Manches (Rounds) ===
# GET  /tournaments/{tournamentId}/rounds
#   Description: Liste toutes les manches d'un tournoi spécifique.
#
# POST /tournaments/{tournamentId}/rounds
#   Description: Crée une nouvelle manche dans un tournoi.
#
# GET  /tournaments/{tournamentId}/rounds/{roundId}
#   Description: Récupère les détails d'une manche spécifique.
#
# === Gestion des Matches ===
# POST /tournaments/{tournamentId}/rounds/{roundId}/matches
#   Description: Ajoute un nouveau match vide à une manche existante.
#   Retourne un objet Match : { id, team1Id, team2Id, team1Point, team2Point }
